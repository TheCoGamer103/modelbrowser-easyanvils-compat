{
  "schemaVersion": 1,
  "id": "mbeacompat",
  "version": "${version}",
  "name": "Model Browser x Easy Anvils Compat",
  "description": "Makes Model Browser work inside Easy Anvils' anvil: the browser panel, renaming to apply models, and resetting them. Adds an in-game menu to hide mods or single models from the browser.",
  "authors": [
    "CoGamer"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/modelbrowser-easyanvils-compat",
    "email": "the.real.cogamer103@gmail.com"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/mbeacompat/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.cogamer.mbeacompat.MbeaCompatClient"
    ]
  },
  "mixins": [
    "mbeacompat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": ">=26.3",
    "java": ">=25",
    "fabric-api": "*",
    "easyanvils": "*",
    "modelbrowser": "*"
  }
}